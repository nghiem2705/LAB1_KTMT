.data
    array: .space 20        
    prompt: .asciiz "Nhap phan tu: "
    space: .asciiz " "

.text
.globl main
main:
    li $t0, 0               
    la $t1, array

input_loop:
    bge $t0, 5, process_array
    
    li $v0, 4
    la $a0, prompt
    syscall
    
    li $v0, 5
    syscall
    sw $v0, 0($t1)
    
    addi $t0, $t0, 1
    addi $t1, $t1, 4
    j input_loop

process_array:
    li $t0, 0
    la $t1, array

process_loop:
    bge $t0, 5, exit
    lw $t2, 0($t1)
    
    andi $t3, $t2, 3        
    beq $t3, 0, print_elem  
    
    beq $t3, 3, round_up
round_down:
    sub $t2, $t2, $t3       
    j print_elem
round_up:
    addi $t2, $t2, 1        

print_elem:
    li $v0, 1
    move $a0, $t2
    syscall
    
    li $v0, 4
    la $a0, space
    syscall
    
    addi $t0, $t0, 1
    addi $t1, $t1, 4
    j process_loop

exit:
    li $v0, 10
    syscall
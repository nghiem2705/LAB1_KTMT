.data
    prompt: .asciiz "Nhap so: "
    err_msg: .asciiz "A factorial for your number can not be found.\n"

.text
.globl main
main:
    li $v0, 4
    la $a0, prompt
    syscall

    li $v0, 5
    syscall
    move $t0, $v0

    blt $t0, 0, print_error 

    li $t1, 1               
    li $t2, 1               
    
fact_loop:
    bgt $t2, $t0, print_fact
    mul $t1, $t1, $t2       
    addi $t2, $t2, 1        
    j fact_loop

print_error:
    li $v0, 4
    la $a0, err_msg
    syscall
    j exit

print_fact:
    li $v0, 1
    move $a0, $t1
    syscall

exit:
    li $v0, 10
    syscall